{# -- Root global variables that all templates inherit from -- #}
{# -- This allows for defining site-wide Twig variables as needed -- #}
{#
┌─────────────────────────────────────────────────────────────────────────────┐
│                                                                             │
│                                                                             │
│                                                                             │
│                                  htmlPage                                   │
└─────────────────────────────────────────────────────────────────────────────┘
#}
{% apply spaceless %}

    {# -- Prefetch & preconnect headers and links -- #}
{#     {% set prefetchUrls = [
        alias("@assetsUrl"),
        alias("@cloudfrontUrl"),
        alias("@ptGoogleAnalyticsProxy"),
        alias("@transcodedEpisodes"),
    ] %} #}
    {# -- General global variables -- #}
{#     {% set baseUrl = alias('@cloudfrontUrl') ~ '/' %}
    {% set assetsUrl = alias('@assetsUrl') ~ '/' %}
    {% set backgroundUrl = "#{baseUrl}site/devmode-fm-light-bg-opaque.svg" %}
    {% set footerBackgroundUrl = "#{baseUrl}site/devmode-fm-dark-bg.svg" %}
    {% set gaTrackingId = getenv('GA_TRACKING_ID') %} #}

    {# -- Twig output from the render; this must be in a block -- #}

    {% set legalPages = [
        {title: 'Terms', href: 'terms'},
        {title: 'GDPR', href: 'gdpr'},
    ] %}

    {% set companyPages = [
        {title: 'About us', href: 'about'},
        {title: 'Responsibility', href: 'responsibility'},
        {title: 'Regulatory Compliance', href: 'regulatory-compliance'},
        {title: 'Awards', href: 'awards'},
    ] %}

    {% set brandPages = [
        {title: 'HEMPE', href: 'hempe'},
        {title: 'MotherSage', href: 'mothersage'},
        {title: 'Brand ambassadors', href: 'brand-ambassadors'},
        {title: 'Where to find us', href: 'find-us'},
        {title: 'Sponsorship', href: 'sponsorship'},
    ] %}

    {% set informationPages = [
        {title: 'Research', href: 'research'},
        {title: 'CBD Explained', href: 'cbd-explained'},
        {title: 'Glossary', href: 'glossary'},
    ] %}

    {% block htmlPage %}
    {% endblock %}

{% endapply %}