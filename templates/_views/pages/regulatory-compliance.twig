{% extends "_layouts/base" %}

{% set meta = {
	eyebrow: 'Our company',
	title: entry.title,
	text: entry.overview
} %}

{% set accreditations = entry.accreditations.all() %}

{% block content %}
	
	<div class="mx-auto max-w-7xl px-6 lg:px-8 prose prose-slate dark:prose-invert">
		{% if entry.text ?? false %}
			<div class="max-w-3xl">
				{{ entry.text }}
			</div>
		{% endif %}
	</div>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		{% if accreditations|length %}
			<div class="grid sm:grid-cols-2 gap-1 overflow-hidden sm:mx-0 rounded-2xl md:grid-cols-3 mb-8">
				{% for item in accreditations %}
					{% set logo = item.logo.one() %}
					<div class="flex flex-col bg-slate-100 dark:bg-slate-200 p-8">
						<h3 class="mb-4 text-center text-base font-semibold text-slate-900">{{ item.title }}</h3>
						{% if logo %}
							<img class="mx-auto max-h-32 w-full object-contain" src="{{ logo.url }}" alt="{{ item.title }}">
						{% endif %}
						{% if item.description %}
							<div class="mt-4 text-sm leading-6 text-slate-600 prose prose-sm prose-slate max-w-none">
								{{ item.description }}
							</div>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		{% endif %}
	</div>

{% endblock %}
